# Cloudflare R2 Configuration
# Copy this file to .env.local and fill in your actual values

# Your Cloudflare Account ID (found in R2 dashboard)
R2_ACCOUNT_ID=your_account_id_here

# R2 API Token credentials (created in R2 API Tokens section)
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here

# Your R2 bucket name
R2_BUCKET_NAME=jgi-resources

# Public URL for your R2 bucket (get this after enabling public access)
# This will be used in the frontend to load files
NEXT_PUBLIC_R2_URL=https://pub-xxxxxxxxxxxxx.r2.dev

# Optional: Custom domain for R2 (if you set one up)
# NEXT_PUBLIC_R2_URL=https://cdn.yourdomain.com
